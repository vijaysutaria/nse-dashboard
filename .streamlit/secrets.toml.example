# Copy to .streamlit/secrets.toml locally, or paste into Streamlit Cloud → App settings → Secrets.

# Hosted Postgres connection string (e.g. from neon.tech). Leave out to use a local SQLite file.
DATABASE_URL = "postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# People must enter this code to create an account. Remove it to allow open sign-ups.
SIGNUP_CODE = "choose-a-code-to-share-with-friends"
